# Machine-local environment. Copy to `.env` (gitignored) and edit.
#
# Sourced by scripts/launchd/run-daemon.sh, so values reach the daemon and
# every process it spawns: workers, MCP servers, sub-agents, skill scripts.
# They do NOT reach the dashboard, trading or fishing services, and they do
# not reach `bun run dev` unless your shell exports them.
#
# Everything here is optional. Keys that enable features belong in
# config.toml under [keys]; this file is for topology and credentials that
# should never sit in a config file that gets backed up.

# ── Logging ──────────────────────────────────────────────────────────────
# EDMUND_LOG_LEVEL=debug
# DEBUG=1

# ── SMS (Twilio) ─────────────────────────────────────────────────────────
# Required when [sms].enabled = true. The auth token is what validates
# inbound webhook signatures; an API key cannot do that.
# TWILIO_ACCOUNT_SID=
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=
# TWILIO_AUTH_TOKEN=

# ── Generation fallback ──────────────────────────────────────────────────
# Some skill scripts read this directly; the runtime uses [keys].openrouter.
# OPENROUTER_API_KEY=

# ── Paths ────────────────────────────────────────────────────────────────
# Override the repository root the CLI operates on, and the config path that
# subprocesses and hooks read. Rarely needed.
# EDMUND_REPO=
# EDMUND_CONFIG_PATH=

# ── Personal skills (LAN topology) ───────────────────────────────────────
# Space-separated host list tried in order; first reachable wins.
# SKYSTREAM_API_HOSTS="http://127.0.0.1:8080 http://192.168.1.50:8080"
# SKYCAM_CAMERA_HOST="192.168.1.100"

# ── Integrations ─────────────────────────────────────────────────────────
# FISHING_API_URL=http://127.0.0.1:8087/api/v1
# KITCHEN_DIR=
# KITCHEN_CHROME_PROFILE=
# CONSTELLATION_REPO=          # mirror UI checkout, for push-ui.sh
# MIRROR_PI_HOST=              # user@host of the mirror Pi, for the helper scripts
# MIRROR_PI_USER=pi
# MIRROR_PI_PASS=              # never commit a value for this anywhere

# ── Radar skills: where "home" is ────────────────────────────────────────
# EDMUND_HOME_LAT=40.0
# EDMUND_HOME_LON=-76.0
# EDMUND_HOME_PLACE="Your Town, Your County"
