{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/mcp/server.ts!",
    "scripts/*.ts!",
    "scripts/*/*.ts!",
    "scripts/*/*/*.ts!",
    "dashboard/server/scripts/*.ts!",
    "integrations/*/index.ts!",
    "integrations/*/tools.ts!",
    "integrations/*/config.ts!",
    "integrations/*/scripts/*.ts!",
    "tests/**/*.test.ts",
    "tests/fixtures/*.ts",
    "integrations/*/test/fixtures/*.ts",

    "src/ghost/mcp-server.ts!"
  ],
  "project": [
    "src/**/*.ts",
    "cli/**/*.ts",
    "scripts/**/*.ts",
    "integrations/**/*.ts",
    "dashboard/server/**/*.ts",
    "tests/**/*.ts"
  ],
  "ignoreBinaries": [
    "tail",
    "vite",
    "afconvert",
    "ffmpeg",
    "ffprobe",
    "osascript",
    "pgrep",
    "pkill",
    "plutil",
    "say",
    "sips",
    "swiftc"
  ],
  "ignoreDependencies": ["sharp"]
}
